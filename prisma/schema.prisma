generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String             @id @default(uuid()) @db.Uuid
  firstName               String             @db.VarChar(100)
  lastName                String             @db.VarChar(100)
  email                   String             @unique @db.VarChar(254)
  passwordHash            String             @db.VarChar(255)
  createdAt               DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime           @updatedAt @db.Timestamptz(3)
  presencePreference      PresencePreference @default(Online)
  authSessions            AuthSession[]
  workspaceMemberships    WorkspaceMember[]
  createdWorkspaceInvites WorkspaceInvite[]
  messages                Message[]
  announcements           Announcement[]
  notifications           Notification[]
  conversationsAsFirst    Conversation[]     @relation("ConversationFirstUser")
  conversationsAsSecond   Conversation[]     @relation("ConversationSecondUser")
  directMessages          DirectMessage[]
}

enum PresencePreference {
  Online
  Away
  Dnd
}

enum WorkspaceRole {
  Owner
  Admin
  Member
}

model Workspace {
  id            String            @id @default(uuid()) @db.Uuid
  name          String            @db.VarChar(100)
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)
  members       WorkspaceMember[]
  invites       WorkspaceInvite[]
  channels      Channel[]
  announcements Announcement[]
  conversations Conversation[]
}

enum NotificationType {
  AnnouncementPublished
  WorkspaceRoleChanged
  WorkspaceRemoved
  DirectMessageCreated
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  workspaceId String           @db.Uuid
  type        NotificationType
  entityId    String?          @db.Uuid
  title       String           @db.VarChar(200)
  message     String           @db.VarChar(4000)
  readAt      DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, entityId])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, readAt])
}

model Announcement {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @db.Uuid
  authorId        String    @db.Uuid
  title           String    @db.VarChar(200)
  content         String    @db.VarChar(4000)
  publishAt       DateTime? @db.Timestamptz(3)
  publishedAt     DateTime? @db.Timestamptz(3)
  scheduleVersion Int       @default(0)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author          User      @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([workspaceId, publishedAt, createdAt(sort: Desc), id(sort: Desc)])
  @@index([publishedAt, publishAt])
}

model Channel {
  id          String             @id @default(uuid()) @db.Uuid
  workspaceId String             @db.Uuid
  name        String             @db.VarChar(80)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages    Message[]
  readStates  ChannelReadState[]
  // An expression unique index in add_channels enforces workspaceId + lower(name).

  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt, id])
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  channelId String   @db.Uuid
  authorId  String   @db.Uuid
  content   String   @db.VarChar(4000)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  // A GIN trigram index in add_message_search_index supports case-insensitive substring search.

  @@index([channelId, createdAt(sort: Desc), id(sort: Desc)])
}

model ChannelReadState {
  userId            String          @db.Uuid
  workspaceId       String          @db.Uuid
  channelId         String          @db.Uuid
  lastReadMessageId String          @db.Uuid
  // The message ID is a durable cursor tie-breaker, not a foreign key; deleted messages must not reset read progress.
  lastReadCreatedAt DateTime        @db.Timestamptz(3)
  lastReadAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)
  member            WorkspaceMember @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)
  channel           Channel         @relation(fields: [channelId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@id([userId, channelId])
  @@index([channelId, userId])
}

model WorkspaceMember {
  workspaceId       String             @db.Uuid
  userId            String             @db.Uuid
  role              WorkspaceRole      @default(Member)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  channelReadStates ChannelReadState[]
  conversationReadStates ConversationReadState[]
  // A partial unique index in add_workspaces enforces at most one Owner per workspace.

  @@id([workspaceId, userId])
  @@index([userId])
}

model Conversation {
  id            String                  @id @default(uuid()) @db.Uuid
  workspaceId   String                  @db.Uuid
  firstUserId   String                  @db.Uuid
  secondUserId  String                  @db.Uuid
  createdAt     DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime                @updatedAt @db.Timestamptz(3)
  workspace     Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  firstUser     User                    @relation("ConversationFirstUser", fields: [firstUserId], references: [id], onDelete: Restrict)
  secondUser    User                    @relation("ConversationSecondUser", fields: [secondUserId], references: [id], onDelete: Restrict)
  messages      DirectMessage[]
  readStates    ConversationReadState[]

  @@unique([workspaceId, firstUserId, secondUserId])
  @@unique([id, workspaceId])
  @@index([workspaceId, firstUserId])
  @@index([workspaceId, secondUserId])
}

model DirectMessage {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  authorId       String       @db.Uuid
  content        String       @db.VarChar(4000)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author         User         @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
}

model ConversationReadState {
  userId            String          @db.Uuid
  workspaceId       String          @db.Uuid
  conversationId    String          @db.Uuid
  lastReadMessageId String          @db.Uuid
  lastReadCreatedAt DateTime        @db.Timestamptz(3)
  lastReadAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)
  member            WorkspaceMember @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)
  conversation      Conversation    @relation(fields: [conversationId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@id([userId, conversationId])
  @@index([conversationId, userId])
}

model WorkspaceInvite {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  createdById String    @db.Uuid
  tokenHash   String    @unique @db.Char(64)
  expiresAt   DateTime  @db.Timestamptz(3)
  usedAt      DateTime? @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt(sort: Desc), id(sort: Desc)])
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique @db.Char(64)
  expiresAt        DateTime  @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
