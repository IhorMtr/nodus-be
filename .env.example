NODE_ENV=development
PORT=3000
# The optional local Docker Compose setup exposes PostgreSQL on port 15432.
DATABASE_URL=postgresql://nodus:replace-with-a-random-password@localhost:15432/nodus?schema=public
REDIS_URL=redis://localhost:6379

# Generate two DIFFERENT secrets: node -e "process.stdout.write(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Comma-separated frontend origins, without paths or trailing slashes.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
POSTGRES_USER=nodus
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_DB=nodus
