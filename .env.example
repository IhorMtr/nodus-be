NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://nodus:replace-with-a-random-password@localhost:5432/nodus?schema=public
REDIS_URL=redis://localhost:6379

# Generate two DIFFERENT secrets: node -e "process.stdout.write(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Number of reverse proxies that append to X-Forwarded-For. Keep 0 locally.
# On Render set 1 (its load balancer). A value above the real hop count lets clients spoof their IP.
TRUST_PROXY_HOPS=0

LOG_LEVEL=info