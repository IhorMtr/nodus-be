NODE_ENV=development
PORT=3000
# The optional local Docker Compose setup exposes PostgreSQL on port 15432.
DATABASE_URL=postgresql://nodus:replace-with-a-random-password@localhost:15432/nodus?schema=public
REDIS_URL=redis://localhost:6379

# Generate two DIFFERENT secrets: node -e "process.stdout.write(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=info