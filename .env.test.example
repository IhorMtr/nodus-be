NODE_ENV=test
# Used by docker-compose.test.yml; DATABASE_URL must match them.
POSTGRES_DB=nodus_test
POSTGRES_USER=nodus
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://nodus:CHANGE_ME@localhost:15433/nodus_test?schema=public
